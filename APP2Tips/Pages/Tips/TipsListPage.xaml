<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="APP2Tips.Pages.Tips.TipsListPage"
             Title="Tips">
    <ContentPage.Content>
        <StackLayout Padding="10" Spacing="10">
            <Button Text="Agregar Tip" Clicked="OnAddTipClicked" />

            <CollectionView x:Name="TipsCollection" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="10" CornerRadius="8" BackgroundColor="{StaticResource Gray950}">
                            <StackLayout Spacing="6">
                                <Label Text="{Binding TituloTip}" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource White}" LineBreakMode="TailTruncation" MaxLines="1" />
                                <Label Text="{Binding DescripcionTip}" TextColor="{StaticResource Gray300}" LineBreakMode="TailTruncation" MaxLines="3" />

                                <ScrollView Orientation="Vertical" HeightRequest="120">
                                    <Label Text="{Binding CodigoTip}" FontFamily="Consolas" TextColor="{StaticResource Gray100}" />
                                </ScrollView>

                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="" />
                                    <Button Grid.Column="1" Text="Editar" Clicked="OnEditTipClicked" CommandParameter="{Binding ID}" />
                                    <Button Grid.Column="2" Text="Eliminar" Clicked="OnDeleteTipClicked" CommandParameter="{Binding ID}" />
                                </Grid>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </StackLayout>
    </ContentPage.Content>
</ContentPage>